# Скопируйте в .env:  cp .env.example .env

# Токен прокси. Попадает в контейнер как ORG_PROXY_API_KEY — на это имя ссылается cordis.patch.yml.
ORG_PROXY_API_KEY=

# Порт на этом ПК. Контейнер слушает только 127.0.0.1, с других устройств недоступен.
DSH_HOST_PORT=3080
# Если меняете порт, укажите ссылку с ним же — она печатается в логах для входа.
#DSH_PUBLIC_URL=http://localhost:3080/

# Каталог с проектами внутри файловой системы WSL (например, /home/user/projects), а не в /mnt/c.
# Монтируется в /workspace — рабочую директорию агента.
DSH_WORKSPACE=./workspace

# Образ.
DSH_IMAGE=muryginds/dsh
DSH_TAG=latest
