# Скопируйте в .env:  cp .env.example .env
# Файл читают и docker compose (подстановка переменных), и контейнер (env_file).

# ── Модель ───────────────────────────────────────────────────────────────
# Ключ DeepSeek или токен прокси: любая строка без переносов строк.
# Пусто = ввести ключ в UI (Settings → Models), тогда он сохранится в /data/.dsh.
DEEPSEEK_API_KEY=

# Messages-совместимый endpoint (Anthropic-протокол, как у DeepSeek /anthropic).
# Оставьте закомментированным для официального API. dsh сам добавит /v1/messages.
# Читается только из окружения контейнера или /data/.dsh/.env, не из .env проекта.
#DEEPSEEK_BASE_URL=https://proxy.example.com/anthropic

# ── Web UI ───────────────────────────────────────────────────────────────
# Порт внутри контейнера и порт на хосте.
DSH_PORT=3080
DSH_HOST_PORT=3080

# Адрес в ссылке для входа (с launch-токеном) и в DSH_WEB_URL для агента.
# Пусто или none — печатать адрес listener'а (IP контейнера).
#DSH_PUBLIC_URL=http://localhost:3080/

# Дополнительные authority для Host/Origin-проверки (через пробел или запятую):
# имена или IP, по которым UI открывают не с localhost (LAN, reverse proxy).
#DSH_TRUSTED_HOSTS=dsh.example.com 192.168.1.10

# TLS на listener'е: пути внутри контейнера, оба значения вместе.
#DSH_TLS_CERT=/data/certs/fullchain.pem
#DSH_TLS_KEY=/data/certs/privkey.pem

# IP интерфейса внутри контейнера, на котором слушает dsh (по умолчанию авто).
#DSH_HOST=

# ── Агент ─────────────────────────────────────────────────────────────────
#DSH_PERMISSION_MODE=workspace-write
#DSH_TELEMETRY_MODE=DISABLED
#DSH_PROFILE=web
#DSH_EXTRA_ARGS=

# ── Сеть ──────────────────────────────────────────────────────────────────
#HTTP_PROXY=
#HTTPS_PROXY=
#NO_PROXY=

# ── docker compose ────────────────────────────────────────────────────────
DSH_IMAGE=muryginds/dsh
DSH_TAG=latest
# Каталог с проектом на хосте (лучше абсолютный путь), монтируется в /workspace.
DSH_WORKSPACE=./workspace
